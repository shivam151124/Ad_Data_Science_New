   "source": [
    "import pandas as pd\n",
    "data ={'age':[20,25,30,35,40]}\n",
    "data = pd.DataFrame(data)\n",
    "print(data)\n",
    "\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "scale = MinMaxScaler()\n",
    "data['Normal data'] = scale.fit_transform(data[['age']])\n",
    "data"
